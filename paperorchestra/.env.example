# Copy to paperorchestra/.env (gitignored). run.sh exports these for the pipeline.
# LLM backend: Gemini (default models are gemini-3.1-pro-preview) via API key or Vertex AI,
# or OpenAI if you pass --writer_model_name/--reflection_model_name gpt-*.
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
OPENAI_API_KEY=
# Optional but strongly recommended: without it Semantic Scholar rate-limits (HTTP 429).
SEMANTIC_SCHOLAR_API_KEY=
# Literature-search cutoff (YYYY-MM); defaults to the current month.
RESEARCH_CUTOFF=
