# Copy to paperorchestra/.env (gitignored). run.sh exports these for the pipeline.

# --- LLM backend -------------------------------------------------------------
# claude-code (default): every LLM call runs `claude -p`, using Claude Code's own login
# (e.g. your Pro/Max subscription). No API keys needed.
# gemini: upstream behavior; needs GEMINI_API_KEY or VERTEX_AI_* (or OPENAI_API_KEY with gpt-* models).
PO_BACKEND=claude-code
PO_CLAUDE_MODEL=opus          # outline, literature synthesis, section writing, refinement
PO_CLAUDE_FAST_MODEL=sonnet   # paper discovery searches and parsing (upstream used gemini flash)
PO_CLAUDE_EFFORT=             # optional: low | medium | high | xhigh | max
PO_CLAUDE_CONCURRENCY=3       # simultaneous claude processes (keeps subscription rate limits happy)

# --- Only for PO_BACKEND=gemini ---------------------------------------------
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
OPENAI_API_KEY=

# --- Literature metadata (any backend) --------------------------------------
# Semantic Scholar is a paper database, not an LLM. Optional; without a key, searches are rate-limited (HTTP 429).
SEMANTIC_SCHOLAR_API_KEY=
# Literature-search cutoff (YYYY-MM); defaults to the current month.
RESEARCH_CUTOFF=
